# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# TheStatsAPI — leave empty to use mock data
STATS_API_KEY=
STATS_API_BASE_URL=https://api.thestatsapi.com/api

# TheStatsAPI IDs
WYDAD_TEAM_ID=tm_805667
BOTOLA_COMPETITION_ID=comp_30610

# Official ticketing (defaults to https://wydad.ticketing.ma/)
NEXT_PUBLIC_TICKETS_URL=https://wydad.ticketing.ma/

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (newsletter backend) ── Project Settings › API
# Server-only: bypasses RLS, never NEXT_PUBLIC_. Needed by /api/newsletter/*.
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler URI, for `node scripts/migrate.mjs` (local only)
SUPABASE_DB_URL=

# ── Newsletter emails (Resend) ── without both, signups are saved as pending and no email is sent
RESEND_API_KEY=
# Verified sender, e.g. "Wydad AC <newsletter@your-domain>"
NEWSLETTER_FROM_EMAIL=
# Salt for hashing IPs and emails in the abuse log
NEWSLETTER_HASH_SALT=

# ── Community ── Discord invite (https://discord.gg/…); the page shows "opening soon" until set
NEXT_PUBLIC_DISCORD_URL=

# ── Wydad Live partner creator ── shown once both are set (channel id starts with UC…)
LIVE_PARTNER_NAME=
LIVE_PARTNER_YOUTUBE_CHANNEL_ID=
LIVE_PARTNER_URL=
LIVE_PARTNER_AVATAR=
